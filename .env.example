# LINE Messaging API Credentials
# Modern Stateless Channel Access Token (v3) - Only Channel ID & Channel Secret needed:
LINE_CHANNEL_ID=your_channel_id_here
LINE_CHANNEL_SECRET=your_channel_secret_here

# (Optional / Legacy) Only if you use manual long-lived access token:
# LINE_CHANNEL_ACCESS_TOKEN=

# Application Configuration (Optional)
PORT=8000
DATABASE_PATH=data/3dollar_erp.db
